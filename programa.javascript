programa
{

funcao inicio()
{
inteiro idade

escreva("Digite sua idade: ")
leia(idade)

//Estrutura SE/SENÂO
// 'se' significa 'if' em inglês
// dentro dos parenteses, colocamos a condição
se(idade >= 18){
// se a condição for verdadeira
// esse bloco será executado
escreva("Você é Maior de idade")

}
senao {
//se a condição for falsa 
//esse bloco sera executado
escreva("Você não é maior de idade")
}
// apenas um dos dois blocos serão executados,
//nunca os dois
}
}